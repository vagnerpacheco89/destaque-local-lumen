!important;
  font-weight: 800 !important;
  line-height: 1.22 !important;
  letter-spacing: -.025em !important;
}
.diagnostic-features article:nth-child(4) strong::before,
.diagnostic-features article:nth-child(4) small::before {
  content: none !important;
  display: none !important;
}
.diagnostic-features article:nth-child(4) small {
  color: #708078 !important;
  font-size: 13px !important;
  line-height: 1.5 !important;
}

/* Area copy is now actual DOM text. */
.area-card__intro h2 {
  margin: 0 0 18px !important;
  max-width: 470px !important;
  color: #fff !important;
  font-size: clamp(34px, 3.45vw, 52px) !important;
  line-height: 1.03 !important;
  letter-spacing: -.045em !important;
}
.area-card__intro h2::after { content: none !important; display: none !important; }
.area-card__intro > p:last-child {
  margin: 0 !important;
  max-width: 480px !important;
  color: rgba(255,255,255,.72) !important;
  font-size: 15px !important;
  line-height: 1.65 !important;
}
.area-card__intro > p:last-child::after { content: none !important; display: none !important; }

/* FAQ final six questions are semantic/static. */
.faq-media__copy h2 {
  margin: 0 !important;
  max-width: 390px !important;
  color: #fff !important;
  font-size: clamp(30px, 3vw, 43px) !important;
  line-height: 1.06 !important;
  letter-spacing: -.045em !important;
}
.faq-media__copy h2::after,
.faq-media__copy::after {
  content: none !important;
  display: none !important;
}
.faq-media__lead {
  display: block;
  max-width: 400px;
  margin: 16px 0 0;
  color: rgba(255,255,255,.78);
  font-size: 13px;
  line-height: 1.65;
}
#faq .faq-list details {
  display: block !important;
}
#faq .faq-list details summary {
  font-size: 15px !important;
}
#faq .faq-list details > p {
  font-size: 13px !important;
  line-height: 1.72 !important;
}
#faq .faq-list details summary::before,
#faq .faq-list details > p::before {
  content: none !important;
  display: none !important;
}

/* Final CTA copy is semantic/static; this only preserves the frozen visual treatment. */
.final-cta__content .eyebrow {
  margin-bottom: 15px !important;
  color: #f7cb43 !important;
  font-size: 10px !important;
  font-weight: 800 !important;
  letter-spacing: .14em !important;
}
.final-cta__content .eyebrow::after { content: none !important; display: none !important; }

.final-cta__content h2 {
  max-width: 690px !important;
  margin-bottom: 18px !important;
  color: #fff !important;
  font-size: clamp(38px, 4vw, 58px) !important;
  line-height: 1.02 !important;
  letter-spacing: -.05em !important;
}
.final-cta__content h2::after { content: none !important; display: none !important; }

.final-cta__content > p.final-cta__support {
  max-width: 610px !important;
  margin: 0 !important;
  color: rgba(255,255,255,.76) !important;
  font-size: 15px !important;
  line-height: 1.7 !important;
}
.final-cta__content > p.final-cta__support::after { content: none !important; display: none !important; }

.final-cta__content .btn {
  font-size: 12px !important;
  font-weight: 900 !important;
}
.final-cta__content .btn::before { content: none !important; display: none !important; }

.final-cta__content::after { content: none !important; display: none !important; }
.final-cta__content > p.final-cta__note {
  display: block !important;
  max-width: 560px !important;
  margin: 20px 0 0 !important;
  color: rgba(255,255,255,.60) !important;
  font-size: 10.5px !important;
  font-weight: 700 !important;
  line-height: 1.6 !important;
  letter-spacing: .01em !important;
}
.final-cta__content > p.final-cta__note::after { content: none !important; display: none !important; }

.final-cta__card::after { content: none !important; display: none !important; }
.final-cta__badge {
  position: absolute;
  z-index: 4;
  right: 24px;
  bottom: 24px;
  padding: 10px 14px 10px 31px;
  border: 1px solid rgba(245,191,37,.92);
  border-radius: 999px;
  background: #f5bf25;
  color: #10442f;
  box-shadow: 0 10px 24px rgba(245,191,37,.22);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .035em;
}
.final-cta__badge-mobile { display: none; }

@media (max-width: 980px) {
  .hero-contact {
    width: 326px !important;
    padding: 20px 20px 17px !important;
  }

  .hero-contact strong { max-width: 100% !important; }
  .hero-proof { width: min(610px, 100%); }
  .hero-proof > span { font-size: 11px !important; }

  .site-header { padding: 8px 0 6px !important; }
  .site-header .nav {
    height: 62px !important;
    padding-inline: 14px !important;
    border-radius: 18px;
  }
  .site-header .brand__mark {
    width: 38px !important;
    height: 38px !important;
  }
  .site-header .nav-demo-tag { margin-right: auto !important; }
  .site-header.is-compact { padding: 4px 0 !important; }
  .site-header.is-compact .nav { height: 56px !important; }

  .final-cta__badge {
    right: 20px;
    bottom: 20px;
  }
}

@media (max-width: 820px) {
  .area-card__intro > p:last-child { font-size: 14px !important; }
}

@media (max-width: 680px) {
  [id] { scroll-margin-top: 82px; }

  .hero { padding-bottom: 28px !important; }
  .hero-contact {
    left: 18px !important;
    right: 18px !important;
    width: auto !important;
    padding: 18px 18px 16px !important;
  }
  .hero-contact strong {
    max-width: none !important;
    text-align: center;
    white-space: normal;
  }
  .hero-contact .text-link {
    width: 100% !important;
    margin-left: 0 !important;
  }
  .hero-proof {
    grid-template-columns: 1fr !important;
    gap: 7px !important;
  }
  .hero-proof > span {
    min-height: 46px !important;
    font-size: 12px !important;
  }

  .site-header { padding: 6px 0 5px !important; }
  .site-header .nav {
    width: min(100% - 24px, 1180px) !important;
    height: 58px !important;
    padding-inline: 12px !important;
    gap: 9px !important;
    border-radius: 16px;
  }
  .site-header .brand { gap: 9px !important; }
  .site-header .brand__mark {
    width: 35px !important;
    height: 35px !important;
    font-size: 11.5px !important;
  }
  .site-header .brand__text strong { font-size: 13px !important; }
  .site-header .brand__text small {
    margin-top: 3px !important;
    font-size: 8px !important;
  }
  .site-header .nav-demo-tag {
    min-height: 22px !important;
    padding-inline: 7px !important;
    font-size: 7.5px !important;
  }
  .site-header .menu-toggle {
    width: 40px;
    height: 40px;
    padding: 9px;
  }
  .mobile-menu {
    width: calc(100% - 24px);
    border-radius: 14px;
  }
  .site-header.is-compact .nav { height: 54px !important; }

  .diagnostic-card__head h2 {
    font-size: clamp(27px, 8.4vw, 32px) !important;
  }
  .diagnostic-features article:nth-child(4) strong { font-size: 15px !important; }
  .diagnostic-features article:nth-child(4) small { font-size: 12.5px !important; line-height: 1.48 !important; }

  .faq-media__copy h2 { font-size: 32px !important; }
  .faq-media__lead { margin-top: 13px; font-size: 12px; }
  #faq .faq-list details summary { font-size: 14px !important; }
  #faq .faq-list details > p { font-size: 12.5px !important; line-height: 1.65 !important; }

  .final-cta__content h2 { font-size: clamp(32px, 10vw, 43px) !important; }
  .final-cta__content > p.final-cta__support { font-size: 14px !important; }
  .final-cta__content > p.final-cta__note {
    margin-top: 16px !important;
    text-align: left !important;
    font-size: 10px !important;
  }
  .final-cta__badge {
    right: 16px !important;
    bottom: 16px !important;
    padding: 9px 12px !important;
    font-size: 8.5px !important;
    box-shadow: 0 10px 24px rgba(0,0,0,.12) !important;
  }
  .final-cta__badge-full { display: none; }
  .final-cta__badge-mobile { display: inline; }
}

@media (max-width: 420px) {
  .final-cta__content h2 { font-size: clamp(30px, 9.6vw, 40px) !important; }
}

@media (max-width: 380px) {
  .diagnostic-card__head h2 { font-size: 26px !important; }
}
